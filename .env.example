# API base URL (used for auth, CMS, holidays, etc.)
# Production:
# VITE_API_URL=https://api.artihcus.com:8443
#
# Local testing (run backend on your machine first):
# Copy this file to .env.development.local and set:
#   VITE_API_URL=http://localhost:5000
# Then run: npm run dev
# The frontend will call your local backend (logo/favicon upload, etc.) without deploying.
VITE_API_URL=https://api.artihcus.com:8443
